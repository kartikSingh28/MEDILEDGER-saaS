# Deployment settings for docker-compose.prod.yml.
# Copy to `.env` on the server (NOT committed) and fill in.
#
#   cp .env.production.example .env
#
# Backend secrets live separately in Backend/.env — see Backend/.env.example.

# The address the site is served on.
#   records.example.com  -> Caddy gets a Let's Encrypt certificate automatically
#   :80                  -> plain HTTP, for an IP-only box
DOMAIN=records.example.com

# Must match DOMAIN exactly, scheme included. The app and API share one origin,
# so this is belt-and-braces rather than load-bearing.
CORS_ORIGIN=https://records.example.com

# Where the browser sends API calls. Caddy strips the /api prefix.
# Vite inlines this at build time, so changing it needs `--build`.
VITE_API_URL=https://records.example.com/api

# Postgres password. Generate, do not reuse the local one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Set to true only once the Fabric network is up on this host
FABRIC_ENABLED=false

# Oracle demo only: Tailscale auth key for the permanent Funnel link.
# Used by docker-compose.funnel.yml. See DEPLOY-ORACLE.md, section 4b.
# TS_AUTHKEY=

# Oracle demo, own domain only: token for a named Cloudflare Tunnel (permanent hostname).
# Used by docker-compose.tunnel.yml. See DEPLOY-ORACLE.md, section 4c.
# TUNNEL_TOKEN=
