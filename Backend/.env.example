DATABASE_URL=postgresql://postgres:password@localhost:5432/Mediledger
JWT_SECRET=change-me
# Required: key for AES-256 file encryption
FILE_SECRET=change-me
IPFS_NODE_URL=http://127.0.0.1:5001

# Hyperledger Fabric (blockchain/network/network.sh up)
# Set to false to run without the ledger (consent then lives only in Postgres)
FABRIC_ENABLED=true
# One Fabric organization per hospital (defaults: test-network on localhost)
FABRIC_ORG1_PEER_ENDPOINT=localhost:7051
FABRIC_ORG2_PEER_ENDPOINT=localhost:9051
FABRIC_CHANNEL=mediledger
FABRIC_CHAINCODE=consent
FABRIC_CRYPTO_PATH=fabric/crypto

# Each hospital's Fabric CA issues its users' blockchain identities
FABRIC_ORG1_CA_URL=https://localhost:7054
FABRIC_ORG2_CA_URL=https://localhost:8054
FABRIC_CA_ADMIN=admin
FABRIC_CA_ADMIN_SECRET=adminpw
# Required: encrypts users' Fabric private keys at rest
WALLET_SECRET=change-me
